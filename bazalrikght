  let g='';
  for(let x=0;x<=3000;x+=1000)g+=`<text x="${X(x)}" y="${H-8}" text-anchor="middle">${x}</text>`;
  for(let y=0;y<=ymax;y+=10)g+=`<text x="${L-8}" y="${Y(y)+4}" text-anchor="end">${y}</text><line x1="${L}" x2="${W-R}" y1="${Y(y)}" y2="${Y(y)}" stroke="currentColor" opacity=".12"/>`;
  const pts=ds.map(d=>[X(S.peaks[d]),Y(d)]);
  const path=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join('');
  return`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Cone index by depth">${g}
  <line x1="${X(2000)}" x2="${X(2000)}" y1="${T}" y2="${H-B}" stroke="currentColor" stroke-dasharray="5 5" opacity=".7"/>
  <text x="${X(2000)+6}" y="${T+10}">Roots struggle</text>
  <path d="${path}" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
  ${pts.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="4" fill="currentColor"/>`).join('')}</svg>
  <p class="cap">Cone index (kPa) across, depth (cm) down</p>`;
}

/* ---------- data in ---------- */
function addReading(r){r.time=new Date().toLocaleTimeString();S.readings.push(r);hop();render()}
function addPush(d,n,k){if(!ok(d)||!ok(k))return;S.peaks[d]=Math.max(S.peaks[d]||0,k);S.depth=d;if(!addPush.q){addPush.q=1;requestAnimationFrame(()=>{addPush.q=0;render()})}}
function handleLine(l){
  if(!l||!/^[-\d.,naif]+$/i.test(l))return;
  const p=l.split(',').map(parseFloat);
  if(p.length===2)addReading({temp:p[0],ph:p[1]});
  else if(p.length===3)addPush(p[0],p[1],p[2]);
}

/* ---------- commands out ---------- */
async function send(c){
  if(S.live){try{await S.writer.write(c)}catch(e){toast('Lost the connection to the Arduino.');drop()}return}
  if(c==='r')setTimeout(()=>addReading({temp:rand(12,22),ph:rand(5.8,7.4)}),450);
  if(c==='p'){S.demoDepth=0;clearInterval(S.demoTimer);S.demoTimer=setInterval(()=>addPush(S.demoDepth,0,Math.max(0,250+S.demoDepth*60+rand(-130,130))),100)}
  if(c==='n')S.demoDepth+=5;
  if(c==='x')clearInterval(S.demoTimer);
  if(c==='z')toast('Zeroed (demo)');
}
function act(a){
  if(a==='read')send('r');
  if(a==='push'){S.peaks={};S.pushing=true;send('p');render()}
  if(a==='next')send('n');
  if(a==='stop'){S.pushing=false;send('x');render()}
  if(a==='zero'){if(S.pushing)return toast('Stop the push first, then zero with nothing on the cone.');send('z')}
  if(a==='csv')csv();
}

/* ---------- serial ---------- */
async function connect(){
  if(S.live)return drop(true);
  if(!('serial' in navigator))return toast('Live mode needs Chrome or Edge on a computer. Demo data keeps running.');
  try{
    const port=await navigator.serial.requestPort();
    await port.open({baudRate:115200});
    const enc=new TextEncoderStream();enc.readable.pipeTo(port.writable);
    const dec=new TextDecoderStream();port.readable.pipeTo(dec.writable);
    S.port=port;S.writer=enc.writable.getWriter();S.live=true;
    clearInterval(S.demoTimer);S.readings=[];S.peaks={};S.pushing=false;
    status();render();toast('Connected. Press Take reading.');
    pump(dec.readable.getReader());
  }catch(e){toast('Could not open the port. Close the Arduino Serial Monitor and try again.')}
}
async function pump(rd){let buf='';try{for(;;){const{value,done}=await rd.read();if(done)break;buf+=value;let i;while((i=buf.indexOf('\n'))>=0){handleLine(buf.slice(0,i).trim());buf=buf.slice(i+1)}}}catch(e){}drop()}
async function drop(user){
  const p=S.port;S.live=false;S.port=null;S.writer=null;S.pushing=false;
  try{if(p)await p.close()}catch(e){}
  status();render();if(!user)toast('Arduino disconnected. Back to demo data.');
}
function status(){$('#status').classList.toggle('live',S.live);$('#mode').textContent=S.live?'Live from Arduino':'Demo data';$('#connect').textContent=S.live?'Disconnect':'Connect Arduino'}

/* ---------- export ---------- */
function csv(){
  if(!S.readings.length&&!Object.keys(S.peaks).length)return toast('Nothing to download yet.');
  let t='time,temp_C,pH\n'+S.readings.map(r=>[r.time,r.temp,r.ph].join(',')).join('\n');
  t+='\n\ndepth_cm,peak_cone_index_kPa\n'+Object.keys(S.peaks).map(d=>d+','+S.peaks[d].toFixed(0)).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([t],{type:'text/csv'}));a.download='soil-probe-log.csv';a.click();
}

/* ---------- dancer: click to pause or resume ---------- */
const dancer=$('#dancer');
if(matchMedia('(prefers-reduced-motion:reduce)').matches){dancer.classList.add('rest');dancer.setAttribute('aria-pressed','false')}
dancer.addEventListener('click',()=>{const r=dancer.classList.toggle('rest');dancer.setAttribute('aria-pressed',String(!r))});

/* ---------- wiring ---------- */
$('#list').addEventListener('click',e=>{const b=e.target.closest('.item');if(b){S.sel=b.dataset.k;render()}});
$('#actions').addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(b)act(b.dataset.a)});
$('#connect').addEventListener('click',connect);

/* ---------- one orchestrated moment: the loader ---------- */
(function boot(){
  const L=$('#loader'),P=$('#pct');status();render();
  const finish=()=>{L.classList.add('done');setTimeout(()=>L.remove(),800);send('r')};
  if(matchMedia('(prefers-reduced-motion:reduce)').matches){L.remove();send('r');return}
  const t0=performance.now(),D=1900;
  (function tick(now){const p=Math.min(1,(now-t0)/D),e=1-Math.pow(1-p,3);P.textContent=Math.round(e*100);p<1?requestAnimationFrame(tick):setTimeout(finish,250)})(t0);
})();
</script>
