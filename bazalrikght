<script>
const $=s=>document.querySelector(s);
const rand=(a,b)=>a+Math.random()*(b-a);
const ok=v=>typeof v==='number'&&isFinite(v);
const S={sel:'temp',readings:[],peaks:{},live:false,pushing:false,port:null,writer:null,demoDepth:0,demoTimer:null};

const SENSORS={
  temp:{name:'Temperature',unit:'°C',dec:1,get:()=>last('temp'),
    verdict:v=>v<5?'Too cold for most seeds to germinate.':v<10?'Cool. Germination will be slow.':v<26?'Good for most seeds and roots.':'Warm. Watch soil moisture.',
    hint:'Used to correct the pH reading.'},
  ph:{name:'pH',unit:'',dec:2,get:()=>last('ph'),
    verdict:v=>v<5.5?'Strongly acidic. Most crops struggle.':v<6?'Acidic. Fine for blueberries, tough for most vegetables.':v<7.1?'Slightly acidic to neutral. Good for most plants.':v<7.9?'Slightly alkaline. Fine for most plants.':'Alkaline. Iron and phosphorus get harder to absorb.',
    hint:'Measured in a soil–distilled water slurry, not dry soil.'},
  comp:{name:'Compaction',unit:'kPa',dec:0,get:()=>{const p=Object.values(S.peaks);return p.length?Math.max(...p):undefined},
    verdict:v=>v<1000?'Loose. Roots move freely.':v<2000?'Firm. Roots are slowed.':'Compacted. Roots struggle past 2000 kPa.',
    hint:'Peak cone index so far. Push steadily and mark every 5 cm.'}
};
const last=k=>{const r=S.readings.at(-1);return r?r[k]:undefined};
const fmt=(s,v)=>ok(v)?v.toFixed(s.dec):'—';

function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove('show'),3400)}
function hop(){const d=$('#dancer');d.classList.remove('pop');void d.offsetWidth;d.classList.add('pop')}

/* ---------- rendering ---------- */
function render(){
  $('#list').innerHTML=Object.entries(SENSORS).map(([k,s])=>
    `<button class="item" data-k="${k}" ${k===S.sel?'aria-current="true"':''}>${s.name}<span class="v">${fmt(s,s.get())}${ok(s.get())?' '+s.unit:''}</span></button>`).join('');
  const s=SENSORS[S.sel],v=s.get();
  $('#big').textContent=fmt(s,v);
  $('#unit').textContent=ok(v)?s.unit:'';
  $('#verdict').textContent=ok(v)?s.verdict(v):(S.sel==='comp'?'Start a push to measure compaction.':'Take a reading to start.');
  $('#hint').textContent=s.hint;
  $('#chart').innerHTML=S.sel==='comp'?profile():trend();
  const comp=S.sel==='comp';
  $('#actions').innerHTML=comp
    ?`<button class="btn primary" data-a="push">${S.pushing?'Pushing…':'Start push'}</button><button class="btn" data-a="next">Next 5 cm</button><button class="btn" data-a="stop">Stop</button><button class="btn" data-a="zero">Zero load cell</button><button class="btn" data-a="csv">Download CSV</button>`
    :`<button class="btn primary" data-a="read">Take reading</button><button class="btn" data-a="csv">Download CSV</button>`;
  const n=S.readings.length;
  $('#meta').textContent=n?`${n} reading${n>1?'s':''}, last at ${S.readings.at(-1).time}`:'No readings yet';
}

function trend(){
  const key={temp:'temp',ph:'ph'}[S.sel];
  const vals=S.readings.map(r=>r[key]).filter(ok).slice(-20);
  if(vals.length<2)return'<p class="cap">Take two readings to see a trend.</p>';
  const W=600,H=140,mn=Math.min(...vals),mx=Math.max(...vals),r=(mx-mn)||1;
  const d=vals.map((v,i)=>(i?'L':'M')+(i/(vals.length-1)*W).toFixed(1)+' '+(H-8-(v-mn)/r*(H-24)).toFixed(1)).join('');
  const s=SENSORS[S.sel];
  return`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img" aria-label="Trend of recent readings"><path d="${d}" fill="none" stroke="currentColor" stroke-width="2.5" vector-effect="non-scaling-stroke"/></svg><p class="cap">Last ${vals.length} readings, from ${mn.toFixed(s.dec)} to ${mx.toFixed(s.dec)} ${s.unit}</p>`;
}

function profile(){
  const ds=Object.keys(S.peaks).map(Number).sort((a,b)=>a-b);
  if(!ds.length)return'<p class="cap">Press Start push, then Next 5 cm each time the cone passes another 5 cm.</p>';
  const W=600,H=260,L=44,R=12,T=14,B=26;
  const xmax=Math.max(3000,...Object.values(S.peaks))*1.05,ymax=Math.max(30,ds.at(-1)+5);
